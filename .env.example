# AI Customer Support Response Quality Auditor - Environment Template
# Copy to .env and fill in values. Never commit .env or real customer data.

APP_ENV=development
# Optional shared bearer token for network/shared deployments. Leave empty only for a
# trusted local single-user instance.
API_ACCESS_TOKEN=
DATABASE_URL=sqlite:///./auditor.db
# For PostgreSQL: postgresql+psycopg://user:password@localhost:5432/auditor

# --- Application security ---
# Used to encrypt saved provider API keys at rest. If empty, a 0600 key file is
# generated at data/.provider_key. This is encryption at rest, not a hardware vault.
AUDITOR_SECRET_KEY=
# Browser origins allowed to call the API. Keep this narrow in shared deployments.
CORS_ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
# Reject oversized JSON requests before parsing (policy uploads use MAX_UPLOAD_MB).
MAX_REQUEST_BYTES=2097152

# --- Provider Configuration ---
# Environment variables are the recommended option for shared deployments. A saved
# connection from Settings can override the fields it explicitly stores. Saved keys
# live in data/provider_connections.json and are encrypted with AUDITOR_SECRET_KEY.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Any OpenAI-compatible endpoint (remote or local).
CUSTOM_API_KEY=
CUSTOM_BASE_URL=http://localhost:11434/v1
CUSTOM_MODEL=llama3.2

# Local Ollama OpenAI-compatible endpoint. Credentials are not required locally.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_API_KEY=ollama

# --- Limits ---
MAX_UPLOAD_MB=10
REQUEST_TIMEOUT_S=30
PROVIDER_RETRY_ATTEMPTS=2
# Optional JSON headers for compatible providers; keep credentials in API key variables.
# CUSTOM_HEADERS_JSON={"X-Organization":"example"}
# OPENAI_HEADERS_JSON={"X-Organization":"example"}
# ANTHROPIC_HEADERS_JSON={"X-Organization":"example"}
# OPENROUTER_HEADERS_JSON={"HTTP-Referer":"https://example.org","X-Title":"Support Auditor"}
DAILY_TOKEN_BUDGET=100000
# Optional hard cap. Requires your own current provider rates below; 0 disables spend cap.
DAILY_SPEND_LIMIT_USD=0
# Supply current documented rates yourself; no defaults are assumed.
# PROVIDER_PRICING_JSON={"openai":{"input_usd_per_1m":0,"output_usd_per_1m":0}}

# --- Frontend ---
API_BASE_URL=http://localhost:8000
STREAMLIT_PORT=8501
